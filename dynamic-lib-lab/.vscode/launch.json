{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "调试 test.exe（显式加载 mymath.dll）",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/test.exe",
            "args": [],
            "cwd": "${workspaceFolder}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "miDebuggerPath": "D:/w64devkit/bin/gdb.exe",
            "preLaunchTask": "编译 test.exe（显式链接）",
            "setupCommands": [
                {
                    "description": "为 gdb 启用整齐打印",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ]
        }
    ]
}
